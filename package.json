{
  "name": "deviceops-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "contracts:check": "node --import tsx scripts/check-contract-sync.ts",
    "verify": "npm run typecheck && npm run contracts:check"
  },
  "dependencies": {
    "expo": "~56.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-camera": "~16.0.10",
    "expo-av": "~15.0.2",
    "expo-status-bar": "~2.0.1",
    "react": "19.2.8",
    "react-native": "0.85.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.72.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
